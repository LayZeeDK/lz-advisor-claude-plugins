  "description": "Derived, pre-registered, stratified eval dataset manifest (EVAL-01). WiCE rows are vendored under wice-vendored/ (ODC-BY/MIT, the only commit-safe corpus). AVeriTeC (CC-BY-NC) and LLM-AggreFact (CC-BY-ND) are FETCH-ONLY: this manifest carries only their IDs + remapped labels + pinned revision + sha256, never the raw corpus text (D-04 license compliance). The remap target is the FROZEN verdict enum unrefuted|refuted.",
  "strata": {
    "supported": {
      "expected_verdict": "unrefuted",
      "note": "WiCE supported (the unrefuted control arm)."
    },
    "subtle": {
      "expected_verdict": "refuted",
      "note": "WiCE partially_supported -- the SUBTLE-overreach spine; the false-uphold trap (D-02)."
    },
    "not-supported": {
      "expected_verdict": "refuted",
      "note": "WiCE not_supported (the easy-flip bad arm)."
    },
    "open-book": {
      "expected_verdict": "varies",
      "note": "AVeriTeC open-book + leakage-test arm; revised KS post-2024-11-15, per-claim date cutoff (D-05). Conflicting/Cherry-picking EXCLUDED from the hard gate. Split into three RETRIEVAL-DIFFICULTY strata (buried / evidence-absent / date-sensitive) so the offline read stresses retrieval orchestration, NOT claim subtlety (19-RESEARCH.md lines 319-360)."
    },
    "buried": {
      "expected_verdict": "refuted",
      "note": "AVeriTeC open-book: a decisive pre-cutoff in-corpus disconfirmer exists but sits DEEP behind topically-similar distractors. Targets the premature-stop failure (the voter stops at the obvious top hits and never reaches the buried disconfirmer)."
    },
    "evidence-absent": {
      "expected_verdict": "refuted",
      "note": "AVeriTeC open-book: a one-step-overreach mutation of a Supported seed whose refutation is NOT in the KS (no in-corpus disconfirmer). Targets the no-counter-evidence-found -> default-uphold failure (the voter must return refuted/insufficient on ABSENCE)."
    },
    "date-sensitive": {
      "expected_verdict": "refuted",
      "note": "AVeriTeC open-book: the decisive disconfirmer is date-gated (post-cutoff docs EXCLUDED by the per-claim cutoff, or a pre-cutoff disconfirmer easy to miss). The axis the prior pilots NEVER tested (the cutoff was not enforced)."
    },
    "stress": {
      "expected_verdict": "varies",
      "note": "LLM-AggreFact held-out verbatim stress set (D-02b)."
    }
  },
