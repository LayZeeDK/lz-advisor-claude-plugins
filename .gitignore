/.claude/*.local.json
/.claude/*.local.md

# Ephemeral Claude Code session state (subagent worktrees, scratch scripts)
/.claude/tmp/
/.claude/worktrees/

# Eval pipeline outputs (regenerated on re-run)
evals/**/outputs/

# Eval dataset cache (fetched at eval time; license-compliant local-only; never committed)
/eval/.cache/
# Eval dev dependencies (pinned in eval/package-lock.json; restored via `cd eval && npm install`; never shipped)
/eval/node_modules/

# Transient /lz-plan side-effect output (plan files written to cwd by skill)
/plans/

# Deep-research run dirs (audit trail; retained on disk, never committed -- INTEG-02 / AGG-05)
/.lz-research/

# playwright-cli skill console logs (tool debris; regenerated per browser session)
/.playwright-cli/
